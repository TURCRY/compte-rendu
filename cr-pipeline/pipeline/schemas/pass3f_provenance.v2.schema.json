{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pass3f_provenance.v2.schema.json",
  "title": "Pass3F provenance registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run", "subjects", "evidence", "truncation_events", "derived_fragments", "stats"],
  "properties": {
    "schema": {"const": "pass3f.provenance.v2"},
    "run": {"type": "object", "additionalProperties": false, "required": ["run_id", "pipeline_kind", "input_hashes"], "properties": {
      "run_id": {"type": "string", "pattern": "^run:[0-9a-f]{64}$"}, "pipeline_kind": {"enum": ["generaliste", "refere"]},
      "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
      "adapter": {"type": "string"}
    }},
    "subjects": {"type": "array", "items": {"$ref": "#/$defs/subject"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "truncation_events": {"type": "array", "items": {"$ref": "#/$defs/truncation_event"}},
    "derived_fragments": {"type": "array", "items": {"$ref": "#/$defs/fragment"}},
    "photo_exclusions": {"type": "array", "items": {"$ref": "#/$defs/photo_exclusion"}, "uniqueItems": true},
    "context_snapshots": {"type": "array", "items": {"$ref": "#/$defs/context_snapshot"}, "uniqueItems": true},
    "stats": {"type": "object", "additionalProperties": false, "required": ["subject_count", "evidence_count", "evidence_occurrence_count", "evidence_content_count", "legacy_evidence_collision_id_count", "derived_fragment_count", "verified_link_count", "candidate_link_count", "unresolved_fragment_count", "confirmed_truncation_subject_count", "confirmed_truncation_fragment_count", "possible_truncation_fragment_count", "unknown_truncation_fragment_count", "truncation_event_count"], "properties": {
      "subject_count": {"type": "integer", "minimum": 0}, "evidence_count": {"type": "integer", "minimum": 0}, "derived_fragment_count": {"type": "integer", "minimum": 0}, "verified_link_count": {"type": "integer", "minimum": 0}, "candidate_link_count": {"type": "integer", "minimum": 0}, "unresolved_fragment_count": {"type": "integer", "minimum": 0},
      "evidence_occurrence_count": {"type": "integer", "minimum": 0}, "evidence_content_count": {"type": "integer", "minimum": 0}, "legacy_evidence_collision_id_count": {"type": "integer", "minimum": 0},
      "confirmed_truncation_subject_count": {"type": "integer", "minimum": 0}, "confirmed_truncation_fragment_count": {"type": "integer", "minimum": 0}, "possible_truncation_fragment_count": {"type": "integer", "minimum": 0}, "unknown_truncation_fragment_count": {"type": "integer", "minimum": 0}, "truncation_event_count": {"type": "integer", "minimum": 0},
      "photo_evidence_count": {"type": "integer", "minimum": 0}, "human_subject_assignment_count": {"type": "integer", "minimum": 0}, "excluded_photo_count": {"type": "integer", "minimum": 0},
      "participant_source_null_count": {"type": "integer", "minimum": 0}, "participant_source_array_count": {"type": "integer", "minimum": 0}, "participant_source_object_count": {"type": "integer", "minimum": 0},
      "description_recovered_count": {"type": "integer", "minimum": 0}
      ,"photo_component_count": {"type": "integer", "minimum": 0}, "photo_component_validated_count": {"type": "integer", "minimum": 0}, "photo_component_unvalidated_count": {"type": "integer", "minimum": 0}, "photo_component_unknown_count": {"type": "integer", "minimum": 0}, "photo_asr_context_count": {"type": "integer", "minimum": 0}, "photo_exclusion_record_count": {"type": "integer", "minimum": 0}, "context_snapshot_count": {"type": "integer", "minimum": 0}
    }}
  },
  "$defs": {
    "subject_scope": {"type":"object","additionalProperties":false,"required":["photo_subject_numero","asr_subject_numeros","editorial_subject_numero"],"properties":{"photo_subject_numero":{"type":["integer","null"],"minimum":1},"asr_subject_numeros":{"type":"array","items":{"type":"integer","minimum":1},"uniqueItems":true},"editorial_subject_numero":{"type":["integer","null"],"minimum":1}}},
    "photo_component": {"type":"object","additionalProperties":false,"required":["component_id","photo_id","content_kind","text","source_file","source_field","origin","validation_status"],"properties":{"component_id":{"type":"string","pattern":"^photo-component:[0-9a-f]{64}$"},"photo_id":{"type":"string","minLength":1},"content_kind":{"enum":["human_assignment","factual_metadata","vlm_description","annotation_label","annotation_comment","photo_dictation","computed_relation","editorial_summary"]},"text":{"type":"string"},"source_file":{"type":"string"},"source_field":{"type":"string"},"origin":{"enum":["ui","batch","pipeline","source","unknown"]},"validation_status":{"enum":["validated","unvalidated","unknown"]},"validation_reason":{"type":"string"},"provenance_fingerprint":{"type":"string","pattern":"^(|[0-9a-f]{64})$"},"parent_component_ids":{"type":"array","items":{"type":"string","pattern":"^photo-component:[0-9a-f]{64}$"},"uniqueItems":true}}},
    "content_components": {"type":"array","items":{"$ref":"#/$defs/photo_component"},"uniqueItems":true},
    "photo_asr_context": {"type":"object","additionalProperties":false,"required":["evidence_occurrence_ids","asr_subject_numeros","link_status"],"properties":{"evidence_occurrence_ids":{"type":"array","items":{"type":"string","pattern":"^evidence-occurrence:[0-9a-f]{64}$"},"uniqueItems":true},"asr_subject_numeros":{"type":"array","items":{"type":"integer","minimum":1},"uniqueItems":true},"link_status":{"enum":["verified","candidate","unresolved"]},"method":{"type":"string"},"score":{"type":"number","minimum":0,"maximum":1},"rule_id":{"type":"string"},"window_start_sec":{"type":["number","null"]},"window_end_sec":{"type":["number","null"]}}},
    "photo_assignment": {"type":"object","additionalProperties":false,"required":["status","authority","record_origin","validation_status"],"properties":{"assignment_id":{"type":"string","pattern":"^photo-assignment:[0-9a-f]{64}$"},"status":{"enum":["assigned","excluded","unassigned"]},"authority":{"enum":["human","source","derived","validated","unknown"]},"record_origin":{"enum":["ui","batch","pipeline","unknown"]},"validation_status":{"enum":["validated","unvalidated","unknown"]},"source_file":{"type":"string"},"source_field":{"type":"string"},"validation_record_id":{"type":"string"}}},
    "photo_file_status": {"type":"object","additionalProperties":false,"required":["exists","metadata_status"],"properties":{"exists":{"type":"boolean"},"metadata_status":{"enum":["complete","partial","unknown"]},"sha256":{"type":"string","pattern":"^(|[0-9a-f]{64})$"},"size_bytes":{"type":["integer","null"],"minimum":0},"mime_type":{"type":"string"},"last_inspected_at":{"type":"string","format":"date-time"}}},
    "photo_exclusion": {"type":"object","additionalProperties":false,"required":["exclusion_id","photo_id","reason_code","source_file","source_field","validation_status"],"properties":{"exclusion_id":{"type":"string","pattern":"^photo-exclusion:[0-9a-f]{64}$"},"photo_id":{"type":"string","minLength":1},"reason_code":{"type":"string","minLength":1},"reason_text":{"type":"string"},"source_file":{"type":"string"},"source_field":{"type":"string"},"validation_status":{"enum":["validated","unvalidated","unknown"]},"provenance_fingerprint":{"type":"string","pattern":"^(|[0-9a-f]{64})$"}}},
    "context_snapshot": {"type":"object","additionalProperties":false,"required":["snapshot_id","pipeline_kind","subject_scope","included_photo_ids","evidence_occurrence_ids","component_ids","selection_rule_ids","source_hashes","context_sha256"],"properties":{"snapshot_id":{"type":"string","pattern":"^context-snapshot:[0-9a-f]{64}$"},"pipeline_kind":{"enum":["generaliste","refere"]},"subject_scope":{"$ref":"#/$defs/subject_scope"},"included_photo_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"photo_exclusion_ids":{"type":"array","items":{"type":"string","pattern":"^photo-exclusion:[0-9a-f]{64}$"},"uniqueItems":true},"evidence_occurrence_ids":{"type":"array","items":{"type":"string","pattern":"^evidence-occurrence:[0-9a-f]{64}$"},"uniqueItems":true},"component_ids":{"type":"array","items":{"type":"string","pattern":"^photo-component:[0-9a-f]{64}$"},"uniqueItems":true},"selection_rule_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"source_hashes":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"context_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"prompt_artifact":{"type":"string"},"prompt_sha256":{"type":"string","pattern":"^(|[0-9a-f]{64})$"},"system_text_sha256":{"type":"string","pattern":"^(|[0-9a-f]{64})$"},"user_text_sha256":{"type":"string","pattern":"^(|[0-9a-f]{64})$"},"text_copy_embedded":{"type":"boolean"},"created_at":{"type":"string","format":"date-time"}}},
    "generation": {"type":"object","additionalProperties":false,"required":["generation_id","kind","generator","validation_status"],"properties":{"generation_id":{"type":"string","pattern":"^generation:[0-9a-f]{64}$"},"kind":{"enum":["llm","deterministic","human"]},"generator":{"type":"string","minLength":1},"model_alias":{"type":"string"},"prompt_artifact":{"type":"string"},"prompt_sha256":{"type":"string","pattern":"^(|[0-9a-f]{64})$"},"input_sha256":{"type":"string","pattern":"^(|[0-9a-f]{64})$"},"output_sha256":{"type":"string","pattern":"^(|[0-9a-f]{64})$"},"parent_component_ids":{"type":"array","items":{"type":"string","pattern":"^photo-component:[0-9a-f]{64}$"},"uniqueItems":true},"rule_id":{"type":"string"},"validation_status":{"enum":["validated","unvalidated","unknown"]},"created_at":{"type":"string","format":"date-time"}}},
    "subject": {"type": "object", "additionalProperties": false, "required": ["subject_id", "numero", "title", "location", "description", "identities", "truncation"], "properties": {
      "subject_id": {"type": "string", "pattern": "^[1-9][0-9]*$"}, "numero": {"type": "integer", "minimum": 1}, "title": {"type": "string"}, "location": {"type": "string"}, "description": {"type": "string"},
      "identities": {"type": "array", "items": {"$ref": "#/$defs/identity"}}, "truncation": {"$ref": "#/$defs/truncation"},
      "description_source": {"type": "string"}, "historical_synthese_file": {"type": "string"}
    }},
    "identity": {"type": "object", "additionalProperties": false, "required": ["canonical", "normalized", "role", "source"], "properties": {
      "canonical": {"type": "string", "minLength": 1}, "normalized": {"type": "string", "minLength": 1},
      "role": {"enum": ["proprietaire", "occupant", "partie", "societe", "organisme", "other"]}, "source": {"type": "string", "minLength": 1}
    }},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_occurrence_id", "evidence_content_id", "identity_algorithm", "source_artifact", "source_hash", "source_pointers", "segment_id", "row_ref", "timecode", "speaker", "exact_text", "exact_text_sha256", "legacy_evidence_id", "legacy_evidence_id_collision", "legacy_evidence_id_occurrence_count", "pass1_subjects", "projection_classification", "reported_subject_count"], "properties": {
      "evidence_occurrence_id": {"type": "string", "pattern": "^evidence-occurrence:[0-9a-f]{64}$"}, "evidence_content_id": {"type": "string", "pattern": "^evidence-content:[0-9a-f]{64}$"}, "identity_algorithm": {"enum": ["pass3f.evidence-occurrence.v2", "pass3f.photo-occurrence.v1"]},
      "source_artifact": {"type": "string"}, "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_pointers": {"type": "array", "items": {"type": "string", "pattern": "^/"}, "minItems": 1, "uniqueItems": true},
      "segment_id": {"type": "string"}, "row_ref": {"type": ["integer", "string", "null"]}, "timecode": {"type": "string"}, "speaker": {"type": "string"}, "exact_text": {"type": "string", "minLength": 1}, "exact_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "legacy_evidence_id": {"type": "string", "pattern": "^evidence:[0-9a-f]{64}$"}, "legacy_evidence_id_collision": {"type": "boolean"}, "legacy_evidence_id_occurrence_count": {"type": "integer", "minimum": 1},
      "pass1_subjects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "projection_classification": {"type": "string"}, "reported_subject_count": {"type": ["integer", "null"]},
      "evidence_kind": {"enum": ["asr", "photo"]}, "provenance_links": {"type": "array", "items": {"$ref": "#/$defs/provenance_link"}},
      "photo": {"$ref": "#/$defs/photo"}
    }},
    "provenance_link": {"type": "object", "additionalProperties": false, "required": ["relation_type", "stage", "authority", "subject_numero", "source_id", "source_artifact", "source_field"], "properties": {
      "relation_type": {"enum": ["subject_assignment", "origin", "context", "projection"]}, "stage": {"type": "string"}, "authority": {"enum": ["human", "source", "derived", "validated"]}, "subject_numero": {"type": ["integer", "null"]}, "source_id": {"type": "string"}, "source_artifact": {"type": "string"}, "source_field": {"type": "string"}
      ,"subject_scope": {"$ref": "#/$defs/subject_scope"}, "method": {"type": "string"}, "score": {"type": "number", "minimum": 0, "maximum": 1}, "rule_id": {"type": "string"}, "link_status": {"enum": ["verified", "candidate", "unresolved"]}
    }},
    "photo": {"type": "object", "additionalProperties": false, "required": ["photo_rel_native", "photo_display", "timestamp_hms", "chrono_sec", "photo_sha256", "metadata_sources", "human_subject_numero", "pass2f_source_artifacts", "context_asr_evidence_ids"], "properties": {
      "photo_rel_native": {"type": "string", "minLength": 1}, "photo_display": {"type": "string", "minLength": 1}, "timestamp_hms": {"type": "string"}, "chrono_sec": {"type": ["number", "null"]}, "photo_sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"}, "metadata_sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "human_subject_numero": {"type": "integer", "minimum": 1}, "pass2f_source_artifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "context_asr_evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^evidence-occurrence:[0-9a-f]{64}$"}, "uniqueItems": true}
      ,"subject_scope": {"$ref": "#/$defs/subject_scope"}, "assignment": {"$ref": "#/$defs/photo_assignment"}, "file_status": {"$ref": "#/$defs/photo_file_status"}, "content_components": {"$ref": "#/$defs/content_components"}, "asr_context": {"$ref": "#/$defs/photo_asr_context"}
    }},
    "link": {"type": "object", "additionalProperties": false, "required": ["evidence_occurrence_id", "link_status", "method", "score"], "properties": {
      "evidence_occurrence_id": {"oneOf": [{"type": "string", "pattern": "^evidence-occurrence:[0-9a-f]{64}$"}, {"type": "null"}]}, "link_status": {"enum": ["verified", "candidate", "unresolved"]}, "method": {"enum": ["normalized_exact_containment", "token_overlap", "structured_photo_reference", "explicit_photo_identifier", "none"]}, "score": {"type": "number", "minimum": 0, "maximum": 1}
    }},
    "truncation": {"type": "object", "additionalProperties": false, "required": ["status", "stage", "scope", "source_file", "source_hash", "details", "event_refs"], "properties": {
      "status": {"enum": ["none", "confirmed", "possible", "unknown"]}, "stage": {"const": "2E"}, "scope": {"enum": ["subject", "chunk", "fragment", "unknown"]},
      "source_file": {"type": "string"}, "source_hash": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"}, "details": {"type": "string"},
      "event_refs": {"type": "array", "items": {"type": "string", "pattern": "^truncation:[0-9a-f]{64}$"}, "uniqueItems": true}
    }},
    "truncation_event": {"type": "object", "additionalProperties": false, "required": ["event_id", "subject_id", "operation", "chunk_index", "chunk_total", "status", "stage", "scope", "source_file", "source_line", "source_hash", "details"], "properties": {
      "event_id": {"type": "string", "pattern": "^truncation:[0-9a-f]{64}$"}, "subject_id": {"type": "string", "pattern": "^[1-9][0-9]*$"}, "operation": {"enum": ["chunk", "merge"]},
      "chunk_index": {"type": ["integer", "null"]}, "chunk_total": {"type": ["integer", "null"]}, "status": {"const": "confirmed"}, "stage": {"const": "2E"}, "scope": {"enum": ["chunk", "subject"]},
      "source_file": {"type": "string", "minLength": 1}, "source_line": {"type": "integer", "minimum": 1}, "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "details": {"type": "string", "minLength": 1}
    }},
    "fragment": {"type": "object", "additionalProperties": false, "required": ["fragment_id", "stage", "subject_id", "field_path", "text", "source_artifact", "representation_type", "structure_algorithm", "links", "truncation"], "properties": {
      "fragment_id": {"type": "string", "pattern": "^fragment:[0-9a-f]{64}$"}, "stage": {"enum": ["2E", "2F", "3E"]}, "subject_id": {"type": "string"}, "field_path": {"type": "string"}, "text": {"type": "string", "minLength": 1}, "source_artifact": {"type": "string"}, "links": {"type": "array", "items": {"$ref": "#/$defs/link"}, "minItems": 1}, "truncation": {"$ref": "#/$defs/truncation"}
      ,"representation_type": {"enum": ["publishable_text_unit", "provenance_projection", "participant_object", "participant_subfield", "metadata", "unsupported"]}, "structure_algorithm": {"const": "pass3f.fragment-structure.v1"}
      ,"subject_scope": {"$ref": "#/$defs/subject_scope"}, "generation": {"$ref": "#/$defs/generation"}
    }}
  }
}
