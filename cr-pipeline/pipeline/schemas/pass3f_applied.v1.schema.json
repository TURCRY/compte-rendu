{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pass3f_applied.v1.schema.json",
  "title": "Deterministic Pass3F-B1 application result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "application_id", "run_id", "status", "source_hashes", "output_global_hash", "operations", "controls"],
  "properties": {
    "schema": {"const": "pass3f.applied.v1"},
    "application_id": {"type": "string", "pattern": "^application:[0-9a-f]{64}$"},
    "run_id": {"type": "string", "pattern": "^run:[0-9a-f]{64}$"},
    "status": {"enum": ["applied", "partially_applied", "blocked", "no_change"]},
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_by_sujet", "provenance_registry", "audit_proposals", "decisions"],
      "properties": {
        "global_by_sujet": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provenance_registry": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "audit_proposals": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decisions": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "output_global_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/operation"}
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied_text_is_unique", "composite_fragments_unchanged", "unresolved_fragments_not_applied", "evidence_refs_preserved", "unaffected_subjects_identical"],
      "properties": {
        "applied_text_is_unique": {"const": true},
        "composite_fragments_unchanged": {"const": true},
        "unresolved_fragments_not_applied": {"const": true},
        "evidence_refs_preserved": {"const": true},
        "unaffected_subjects_identical": {"const": true}
      }
    }
  },
  "$defs": {
    "fragment_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^fragment:[0-9a-f]{64}$"},
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^evidence:[0-9a-f]{64}$"},
      "uniqueItems": true
    },
    "blocked_fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragment_id", "blocker"],
      "properties": {
        "fragment_id": {"type": ["string", "null"], "pattern": "^fragment:[0-9a-f]{64}$"},
        "blocker": {"type": "string", "minLength": 1}
      }
    },
    "composite_split_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "derived_from_fragment_id", "text", "intended_subject", "destination", "evidence_refs", "provenance_status", "link_status", "shared_composite_evidence", "role", "source_fragment_refs", "notes"],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^composite-unit:[0-9a-f]{64}$"},
        "derived_from_fragment_id": {"type": "string", "pattern": "^fragment:[0-9a-f]{64}$"},
        "text": {"type": "string", "minLength": 1},
        "intended_subject": {"type": ["string", "null"], "pattern": "^[1-9][0-9]*$"},
        "destination": {
          "oneOf": [
            {"type": "string", "pattern": "^subject:[1-9][0-9]*$"},
            {"enum": ["transverse_document_request", "metadata_only", "discard_editorial_wrapper", "unresolved"]}
          ]
        },
        "evidence_refs": {"$ref": "#/$defs/evidence_ids"},
        "provenance_status": {"enum": ["verified", "candidate", "unresolved"]},
        "link_status": {"type": ["string", "null"], "enum": ["verified", "candidate", null]},
        "shared_composite_evidence": {"type": "boolean"},
        "role": {"enum": ["subject_content", "common"]},
        "source_fragment_refs": {"$ref": "#/$defs/fragment_ids"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "composite_split_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split_plan_id", "derived_from_fragment_id", "split_status", "provenance_status", "destination_status", "requires_human_review", "publication_allowed", "original_fragment_retained", "units", "blockers"],
      "properties": {
        "split_plan_id": {"type": "string", "pattern": "^composite-split-plan:[0-9a-f]{64}$"},
        "derived_from_fragment_id": {"type": "string", "pattern": "^fragment:[0-9a-f]{64}$"},
        "split_status": {"enum": ["deterministic", "bounded_llm_required", "bounded_llm_completed", "unresolved"]},
        "provenance_status": {"enum": ["recovered", "partial", "unresolved"]},
        "destination_status": {"enum": ["resolved", "partial", "unresolved"]},
        "requires_human_review": {"const": true},
        "publication_allowed": {"type": "boolean"},
        "original_fragment_retained": {"const": true},
        "units": {"type": "array", "items": {"$ref": "#/$defs/composite_split_unit"}, "minItems": 1},
        "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "decision_id", "action", "source_subject", "target_subject", "status", "applied_fragment_ids", "already_applied_fragment_ids", "pending_simple_fragment_ids", "pending_composite_fragment_ids", "blocked_unresolved_fragment_ids", "blocked_fragments", "composite_split_plans"],
      "properties": {
        "proposal_id": {"type": "string", "pattern": "^proposal:[0-9a-f]{64}$"},
        "decision_id": {"type": "string", "pattern": "^decision:[0-9a-f]{64}$"},
        "action": {"enum": ["move", "merge", "remove_duplicate", "retain_overlap", "no_action"]},
        "source_subject": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "target_subject": {"type": ["string", "null"], "pattern": "^[1-9][0-9]*$"},
        "status": {"enum": ["applied", "partially_applied", "blocked", "no_change", "rejected", "deferred"]},
        "applied_fragment_ids": {"$ref": "#/$defs/fragment_ids"},
        "already_applied_fragment_ids": {"$ref": "#/$defs/fragment_ids"},
        "pending_simple_fragment_ids": {"$ref": "#/$defs/fragment_ids"},
        "pending_composite_fragment_ids": {"$ref": "#/$defs/fragment_ids"},
        "blocked_unresolved_fragment_ids": {"$ref": "#/$defs/fragment_ids"},
        "blocked_fragments": {
          "type": "array",
          "items": {"$ref": "#/$defs/blocked_fragment"}
        },
        "composite_split_plans": {
          "type": "array",
          "items": {"$ref": "#/$defs/composite_split_plan"}
        }
      }
    }
  }
}
